eateElement(\"div\");\n  container.id = \"cf-turnstile-runtime\";\n  container.style.display = \"none\";\n  document.body.appendChild(container);\n}\n\ncontainer.innerHTML = \"\";\n\nconst token = await new Promise((resolve, reject) => {\n  try {\n    const widgetId = window.turnstile.render(\"#cf-turnstile-runtime\", {\n      sitekey: SITE_KEY,\n      size: \"invisible\",\n      callback: function (token) {\n        resolve(token);\n      },\n      \"error-callback\": function () {\n        reject(new Error(\"Erreur Turnstile\"));\n      },\n      \"expired-callback\": function () {\n        wwLib.wwVariable.updateValue(TOKEN_VARIABLE_ID, \"\");\n      }\n    });\n\n    window.turnstile.execute(widgetId);\n  } catch (error) {\n    reject(error);\n  }\n});\n\nwwLib.wwVariable.updateValue(TOKEN_VARIABLE_ID, token);\n\nreturn token;","next":"81aa6712-ecb9-4b40-ac22-13b543091d73","type":"custom-js"},"5dd3cb42-f6f8-46ce-b91b-a6390401ce64":{"id":"5dd3cb42-f6f8-46ce-b91b-a6390401ce64","type":"variable","varId":"e2919021-9904-4301-9bce-0c981935f09c","internal":false,"varValue":false},"660ead9f-bf07-436b-afc9-163f49e57703":{"id":"660ead9f-bf07-436b-afc9-163f49e57703","mode":"page","type":"change-page","pageId":"044bcc88-8aed-4305-95ae-0c2df0783e84","navigateMode":"internal"},"666386c5-1448-4527-af35-919e3981c72c":{"id":"666386c5-1448-4527-af35-919e3981c72c","next":"6a45664f-745d-48f6-8419-ae056c6da902","type":"variable","varId":"e2919021-9904-4301-9bce-0c981935f09c","internal":false,"varValue":false},"680c606c-b642-4f10-ae9f-86d84901f4cf":{"id":"680c606c-b642-4f10-ae9f-86d84901f4cf","next":"1d079f64-b9bd-426e-8511-481b53bc9b92","type":"fetch-collection","collectionId":"8a78aefb-8cec-4fd6-92ca-221443f6a7ad"},"6a45664f-745d-48f6-8419-ae056c6da902":{"id":"6a45664f-745d-48f6-8419-ae056c6da902","name":"Erreur","next":null,"type":"variable","varId":"d378950c-b527-4302-a328-bd99f7caa8d2","internal":false,"varValue":{"code":"(() => {\n  const err = context.workflow?.error;\n  const